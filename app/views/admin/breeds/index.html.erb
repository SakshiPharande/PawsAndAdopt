<div class="container mt-4">
    <h1 class="text-center my-4">Breeds List</h1>

    <div class="d-flex justify-content-start mb-3">
      <%= link_to 'Add Breed', new_admin_breed_path , class: 'btn btn-primary' %>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Breed Name</th>
                <th>Category Name</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <% if @breeds.present? %>
                <% @breeds.each_with_index do |breed, i| %>
                    <tr>
                        <td><%= i+1 %></td>
                        <td><%= breed.breed_name %></td>
                        <td><%= breed.category.category_name if breed.category %></td>
                        <td>
                            <!-- Edit Icon -->
                            <%= link_to edit_admin_breed_path(breed) do %>
                                <i class="bi bi-pencil text-warning me-3" title="Edit"></i>
                            <% end %>
                            <!-- Delete Icon -->
                    
                            <%= link_to discard_admin_breed_path(breed), 
                            data: { turbo_method: :patch, turbo_confirm: "Are you sure you want to delete this breed?" }, 
                            class: "text-danger text-decoration-none", 
                            title: "Soft Delete breed", 
                            rel: "nofollow",
                            style: "text-decoration: none;" do %>
                            <i class="bi bi-trash"></i>
                            <% end %>
                        </td>
                    </tr>
                <% end %>
            <% else %>
                <tr>
                    <td colspan="4" class="text-center">No Breeds found.</td>
                </tr>
            <% end %>
        </tbody>
    </table>
</div>
