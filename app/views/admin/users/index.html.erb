<div class="container mt-4">
    <h1 class="text-center my-4">Users List</h1>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
            <th>ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone No</th>
            <th>Action</th>
            </tr>
        </thead>
      <tbody>
        <% if @users.present? %>
        <% @users.each do |user| %>
            <tr>
                <td><%= user.id %></td>
                <td><%= user.first_name %></td>
                <td><%= user.last_name %></td>
                <td><%= user.email %></td>
                <td><%= user.phone_no %></td>
                <td>
              <!-- View Icon -->
           <%= link_to admin_user_path(user), class: "text-decoration-none" do %>
              <i class="bi bi-eye text-success me-3" title="View User"></i>
            <% end %>
            <!-- Soft Delete Icon -->
            <%= link_to discard_admin_user_path(user), 
                data: { 
                turbo_method: :patch, 
                turbo_confirm: "Are you sure you want to delete this user?" 
                }, 
                class: "text-danger", 
                title: "Soft Delete User", 
                rel: "nofollow" do %>
                <i class="bi bi-trash"></i>
            <% end %>

            </td>
            </tr>
        <% end %>
        <% else %>
            <tr>
            <td colspan="6" class="text-center">No users found.</td>
            </tr>
        <% end %>
        </tbody>
    </table>
  </div>