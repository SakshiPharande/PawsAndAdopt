<tr id="adopt_pet_<%= adopt_pet.id %>" data-status="<%= adopt_pet.status %>">
  <td><%= index %></td>
  <td><%= adopt_pet.user.first_name %> <%= adopt_pet.user.last_name %></td>
  <td><%= adopt_pet.user.email %></td>
  <td><%= adopt_pet.category_name %></td>
  <td><%= adopt_pet.breed_name %></td>
  <td><%= adopt_pet.pet_gender %></td>
  <td>
    <% if adopt_pet.pet.pet_image_url.present? %>
      <img src="<%= adopt_pet.pet.pet_image_url %>" width="80" height="80" alt="Pet Image">
    <% else %>
      No Image
    <% end %>
  </td>
  <td><%= adopt_pet.expected_adoption_date.strftime("%d-%m-%Y") if adopt_pet.expected_adoption_date %></td>
  <td><%= adopt_pet.actual_adoption_date.strftime("%d-%m-%Y") if adopt_pet.actual_adoption_date %></td>
  <td>
    <% status_class = adopt_pet.pending? ? 'bg-warning text-dark' : (adopt_pet.accepted? ? 'bg-success text-white' : 'bg-danger text-white') %>
    <span class="badge <%= status_class %>">
      <%= adopt_pet.status.capitalize %>
    </span>
  </td>
  <td>
    <div class="d-flex gap-2">
      <%= link_to "View", admin_adopt_pet_path(adopt_pet), class: "btn btn-primary btn-sm" %>
      <%= link_to "Accept", admin_adopt_pet_path(adopt_pet, status: :accepted), method: :patch, class: "btn btn-success btn-sm", data: { turbo_method: :patch, turbo_frame: "adopt_pet_#{adopt_pet.id}" } %>
      <%= link_to "Reject", admin_adopt_pet_path(adopt_pet, status: :rejected), method: :patch, class: "btn btn-danger btn-sm", data: { turbo_method: :patch, turbo_frame: "adopt_pet_#{adopt_pet.id}" } %>
    </div>
  </td>
</tr>
