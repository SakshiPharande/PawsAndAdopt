<div class="container mt-4">
    <h1 class="text-center my-4">Donate Pet Requests</h1>

    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>User Name</th>
                    <th>User Email</th>
                    <th>Category</th>
                    <th>Breed</th>
                    <th>Pet Gender</th>
                    <th>Pet Image</th>
                    <th>Expected Donation Date</th>
                    <th>Actual Donation Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% if @donate_pets.present? %>
                    <% @donate_pets.each do |donate_pet| %>
                        <turbo-frame id="donate_pet_<%= donate_pet.id %>">
                            <%= render partial: "admin/donate_pets/donate_pet", locals: { donate_pet: donate_pet } %>
                        </turbo-frame>
                    <% end %>
                <% else %>
                    <tr>
                        <td colspan="11" class="text-center">No donation requests found.</td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    </div>
</div>
