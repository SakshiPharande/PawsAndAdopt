<div class="container mt-4">
  <h2 class="text-center mb-4">Edit Category</h2>

  <%= form_with model: @category, url: admin_category_path(@category), method: :patch, local: true, class: "needs-validation" do |f| %>
    <div class="mb-3">
      <%= f.label :category_name, "Category Name", class: "form-label" %>
      <%= f.text_field :category_name, class: "form-control", placeholder: "Enter category name", required: true %>
    </div>

    <div class="text-center">
      <%= f.submit "Update Category", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
