<div class="container mt-4">
    <h1 class="text-center my-4">Category List</h1>

    <div class="d-flex justify-content-start mb-3">
      <%= link_to 'Add Category', new_admin_category_path ,class: 'btn btn-primary' %>
    </div>


    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
            <th>ID</th>
            <th>Category Name</th>
            <th>Action</th>
            </tr>
        </thead>
      <tbody>
        <% if @categories.present? %>
        <% @categories.each do |category| %>
            <tr>
                <td><%= category.id %></td>
                <td><%= category.category_name %></td>
                <td>
                    <!-- Edit Icon -->
                    <%= link_to edit_admin_category_path(category) do %>
                    <i class="bi bi-pencil text-warning me-3" title="Edit"></i>
                    <% end %>
                    <!-- Delete Icon -->
                    <%= link_to discard_admin_category_path(category), 
                        data: { turbo_method: :patch, turbo_confirm: "Are you sure you want to delete this category?" }, 
                        class: "text-danger text-decoration-none", 
                        title: "Soft Delete category", 
                        rel: "nofollow",
                        style: "text-decoration: none;" do %>
                        <i class="bi bi-trash"></i>
                    <% end %>
                </td>
            </tr>
        <% end %>
        <% else %>
            <tr>
            <td colspan="6" class="text-center">No Category found.</td>
            </tr>
        <% end %>
        </tbody>
    </table>
  </div>