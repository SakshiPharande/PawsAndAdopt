<div class="container mt-4">
    <h1 class="text-center my-4">Pets List</h1>

    <div class="d-flex justify-content-start mb-3">
      <%= link_to 'Add Pet', new_admin_pet_path , class: 'btn btn-primary' %>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Category Name</th>
                <th>Breed Name</th>
                <th>Age</th>
                <th>Gender</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <% if @pets.present? %>
                <% @pets.each do |pet| %>
                    <tr>
                        <td><%= pet.id %></td>
                        <td><%= pet.category.category_name if pet.category %></td>
                        <td><%= pet.breed.breed_name if pet.breed %></td>
                        <td><%= pet.age%></td>
                        <td><%= pet.gender%></td>
                        <td><%= pet.status%></td>
                        <td>
                               <!-- View Icon -->
                            <%= link_to admin_pet_path(pet), class: "text-decoration-none" do %>
                            <i class="bi bi-eye text-success me-3" title="View User"></i>
                            <% end %>

                            <!-- Edit Icon -->
                            <%= link_to edit_admin_pet_path(pet) do %>
                                <i class="bi bi-pencil text-warning me-3" title="Edit"></i>
                            <% end %>

                            <!-- Delete Icon -->
                            <%= link_to discard_admin_pet_path(pet), method: :patch, data: { 
                                turbo_method: :patch, confirm: "Are you sure you want to delete this pet?" 
                            }, class: "text-danger", title: "Delete pet", rel: "nofollow" do %>
                                <i class="bi bi-trash"></i>
                            <% end %>
                        </td>
                    </tr>
                <% end %>
            <% else %>
                <tr>
                    <td colspan="4" class="text-center">No Pets found.</td>
                </tr>
            <% end %>
        </tbody>
    </table>
</div>
